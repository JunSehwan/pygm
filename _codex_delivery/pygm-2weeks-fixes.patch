+  const app = (id, other) => ({ uid: `${id}-owner`, roundId: 'round', status: 'approved', reviewStatus: 'approved', matchingStatus: 'proposed', currentProposal: { matchId: 'match', candidateApplicationId: other, response: 'pending' } });
