rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.toUid == request.auth.uid;
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /charmingCards/{cardId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /charmingCardAnswers/{answerId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    match /interests/{interestId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /manualPayments/{paymentId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /blockedUsers/{docId} {
      allow read, create, update, delete: if signedIn();
    }

    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}