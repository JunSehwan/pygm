rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.uid == "9OqbfNZW6lgq5NLB0lAigkYQxME2" ||
        (
          exists(/databases/$(database)/documents/adminConfig/access) &&
          (
            (get(/databases/$(database)/documents/adminConfig/access).data.get('allowedUids', []) is list &&
              request.auth.uid in get(/databases/$(database)/documents/adminConfig/access).data.get('allowedUids', [])) ||
            (get(/databases/$(database)/documents/adminConfig/access).data.get('superAdmins', []) is list &&
              request.auth.uid in get(/databases/$(database)/documents/adminConfig/access).data.get('superAdmins', []))
          )
        )
      );
    }

    function twoweeksProtectedApplicationFieldsUnchanged() {
      return request.resource.data.get('uid', '') == resource.data.get('uid', '') &&
        request.resource.data.get('roundId', '') == resource.data.get('roundId', '') &&
        request.resource.data.get('status', '') == resource.data.get('status', '') &&
        request.resource.data.get('reviewStatus', '') == resource.data.get('reviewStatus', '') &&
        request.resource.data.get('matchingStatus', '') == resource.data.get('matchingStatus', '') &&
        request.resource.data.get('matchingAvailability', '') == resource.data.get('matchingAvailability', '') &&
        request.resource.data.get('matchingPauseReason', '') == resource.data.get('matchingPauseReason', '') &&
        request.resource.data.get('nextRoundStatus', '') == resource.data.get('nextRoundStatus', '') &&
        request.resource.data.get('currentProposal', {}) == resource.data.get('currentProposal', {}) &&
        request.resource.data.get('scheduleStatus', '') == resource.data.get('scheduleStatus', '') &&
        request.resource.data.get('schedule', {}) == resource.data.get('schedule', {}) &&
        request.resource.data.get('meetingStatus', '') == resource.data.get('meetingStatus', '') &&
        request.resource.data.get('contactOpenStatus', '') == resource.data.get('contactOpenStatus', '') &&
        request.resource.data.get('penaltyStats', {}) == resource.data.get('penaltyStats', {}) &&
        request.resource.data.get('sanctionSummary', {}) == resource.data.get('sanctionSummary', {}) &&
        request.resource.data.get('withdrawal', {}) == resource.data.get('withdrawal', {}) &&
        request.resource.data.get('deposit', {}) == resource.data.get('deposit', {}) &&
        request.resource.data.get('phoneIdentityVerification', {}) == resource.data.get('phoneIdentityVerification', {}) &&
        request.resource.data.get('basic', {}) == resource.data.get('basic', {}) &&
        request.resource.data.get('identity', {}) == resource.data.get('identity', {}) &&
        request.resource.data.get('matchingPreferences', {}) == resource.data.get('matchingPreferences', {}) &&
        request.resource.data.get('profileEdit', {}) == resource.data.get('profileEdit', {}) &&
        request.resource.data.get('profileReview', {}) == resource.data.get('profileReview', {}) &&
        request.resource.data.get('verificationReview', {}) == resource.data.get('verificationReview', {}) &&
        request.resource.data.get('dashboardAccess', {}) == resource.data.get('dashboardAccess', {});
    }

    // 회원가입 Callable을 통하지 않는 레거시 클라이언트 직접 생성에서도 필수 동의를 검사합니다.
    // 기존 신청서의 조회/수정에는 영향을 주지 않습니다.
    function validTwoWeeksRequiredConsentsAtCreate() {
      let consents = request.resource.data.get('consents', {});
      return consents is map &&
        consents.get('privacy', false) == true &&
        consents.get('profileContact', false) == true &&
        consents.get('noShowDeposit', false) == true &&
        consents.get('falseInfo', false) == true;
    }

    function validInitialTwoWeeksDeposit() {
      return request.resource.data.get('deposit', {}).get('status', '') == 'pending' &&
        request.resource.data.get('deposit', {}).get('balance', -1) == 0 &&
        request.resource.data.get('deposit', {}).get('totalDeposited', -1) == 0 &&
        request.resource.data.get('deposit', {}).get('totalDeducted', -1) == 0 &&
        request.resource.data.get('deposit', {}).get('participationEligible', true) == false;
    }

    function validTwoWeeksProfilePhotosAtWrite() {
      let identity = request.resource.data.get('identity', {});
      let representativePhoto = identity.get('representativePhoto', null);
      let additionalPhotos = identity.get('additionalPhotos', []);

      return identity is map &&
        representativePhoto is map &&
        additionalPhotos is list &&
        additionalPhotos.size() >= 2 &&
        additionalPhotos.size() <= 4;
    }

    function isTwoWeeksTestPhone(phone) {
      return phone in ['01000000001', '01000000002', '01000000003'];
    }

    function validTwoWeeksIdentityAtCreate() {
      let basic = request.resource.data.get('basic', {});
      let identity = request.resource.data.get('phoneIdentityVerification', {});
      let verificationId = identity.get('verificationId', '');
      let phone = basic.get('phoneNormalized', '');
      let isTestIdentity =
        request.resource.data.get('testMode', false) == true &&
        isTwoWeeksTestPhone(phone);

      return basic.get('phoneVerified', false) == true &&
        basic.get('phoneVerificationSkipped', true) == false &&
        identity.get('verified', false) == true &&
        identity.get('phone', '') == phone &&
        (
          isTestIdentity ||
          (
            verificationId != '' &&
            exists(/databases/$(database)/documents/twoweeksIdentityVerifications/$(verificationId)) &&
            get(/databases/$(database)/documents/twoweeksIdentityVerifications/$(verificationId)).data.get('verified', false) == true &&
            get(/databases/$(database)/documents/twoweeksIdentityVerifications/$(verificationId)).data.get('ownerUid', '') == request.auth.uid &&
            get(/databases/$(database)/documents/twoweeksIdentityVerifications/$(verificationId)).data.get('phone', '') == phone &&
            request.time < get(/databases/$(database)/documents/twoweeksIdentityVerifications/$(verificationId)).data.expiresAt
          )
        );
    }

    function hasValidTwoWeeksDashboardSession(applicationId) {
      let sessionPath = /databases/$(database)/documents/twoweeksDashboardSessions/$(request.auth.uid);
      return signedIn() &&
        applicationId != '' &&
        exists(sessionPath) &&
        get(sessionPath).data.get('applicationId', '') == applicationId &&
        get(sessionPath).data.get('revoked', false) != true &&
        get(sessionPath).data.get('expiresAt', request.time) > request.time;
    }

    function ownsTwoWeeksApplication(applicationId) {
      return signedIn() &&
        applicationId != '' &&
        exists(/databases/$(database)/documents/twoweeksApplications/$(applicationId)) &&
        get(/databases/$(database)/documents/twoweeksApplications/$(applicationId)).data.get('status', '') != 'withdrawn' &&
        get(/databases/$(database)/documents/twoweeksApplications/$(applicationId)).data.get('withdrawal', {}).get('status', '') != 'completed' &&
        (
          get(/databases/$(database)/documents/twoweeksApplications/$(applicationId)).data.get('uid', '') == request.auth.uid ||
          hasValidTwoWeeksDashboardSession(applicationId)
        );
    }

    function isTwoWeeksMatchParticipant(matchData) {
      return ownsTwoWeeksApplication(matchData.get('maleApplicationId', '')) ||
        ownsTwoWeeksApplication(matchData.get('femaleApplicationId', ''));
    }

    function isTwoWeeksResponseParticipant(responseData) {
      return ownsTwoWeeksApplication(responseData.get('viewerApplicationId', '')) ||
        ownsTwoWeeksApplication(responseData.get('candidateApplicationId', ''));
    }

    function validTwoWeeksResponseOwnerWrite() {
      let viewerApplicationId = request.resource.data.get('viewerApplicationId', '');
      let viewerPath = /databases/$(database)/documents/twoweeksApplications/$(viewerApplicationId);
      return ownsTwoWeeksApplication(viewerApplicationId) &&
        exists(viewerPath) &&
        request.resource.data.get('viewerUid', '') == get(viewerPath).data.get('uid', '') &&
        request.resource.data.get('response', '') in ['accepted', 'declined'];
    }

    function validTwoWeeksResponseMatchBinding(responseId) {
      let viewerApplicationId = request.resource.data.get('viewerApplicationId', '');
      let candidateApplicationId = request.resource.data.get('candidateApplicationId', '');
      let matchId = request.resource.data.get('matchId', '');
      let matchPath = /databases/$(database)/documents/twoweeksMatches/$(matchId);

      return viewerApplicationId != '' &&
        candidateApplicationId != '' &&
        matchId != '' &&
        responseId == viewerApplicationId + '_' + candidateApplicationId &&
        exists(matchPath) &&
        (
          (
            get(matchPath).data.get('maleApplicationId', '') == viewerApplicationId &&
            get(matchPath).data.get('femaleApplicationId', '') == candidateApplicationId
          ) ||
          (
            get(matchPath).data.get('femaleApplicationId', '') == viewerApplicationId &&
            get(matchPath).data.get('maleApplicationId', '') == candidateApplicationId
          )
        );
    }

    function twoweeksMatchParticipantUpdateOnlyAllowedFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'scheduleStatus',
        'schedule',
        'photoRevealStatus',
        'mutualAcceptedAt',
        'mutualAcceptedAtClient',
        'declinedByApplicationId',
        'declinedCounterpartApplicationId',
        'declinedAt',
        'declinedAtClient',
        'decline',
        'finalMeeting',
        'meetingReadySms',
        'meetingReadySmsUpdatedAt',
        'meetingAttendance',
        'attendanceStatus',
        'meetingAttendanceSms',
        'finalAttendanceGuideSms',
        'meetingArrival',
        'arrivalStatus',
        'meetingProofs',
        'noShowEvidenceStatus',
        'preMeetingNotes',
        'preMeetingNoteSms',
        'updatedAt'
      ]);
    }

    function preservesTwoWeeksTerminalMatchState() {
      let currentStatus = resource.data.get('status', '');
      let nextStatus = request.resource.data.get('status', '');
      let currentScheduleStatus = resource.data.get('scheduleStatus', '');
      let nextScheduleStatus = request.resource.data.get('scheduleStatus', '');
      let terminalStatuses = [
        'declined',
        'failed',
        'expired',
        'proposal_expired',
        'schedule_expired',
        'counterpart_expired',
        'cancelled',
        'canceled'
      ];

      return (!(currentStatus in terminalStatuses) || nextStatus == currentStatus) &&
        (!(currentScheduleStatus in terminalStatuses) || nextScheduleStatus == currentScheduleStatus);
    }

    function validTwoWeeksScheduleTimeChoices() {
      let policy = resource.data.get('schedulePolicy', {});
      let policyVersion = policy.get('version', '');
      let allowedIds = policy.get('allowedTimeOptionIds', []);
      let allowedStartAt = policy.get('timeOptionStartAtById', {});
      let nextSchedule = request.resource.data.get('schedule', {});
      let nextScheduleStatus = request.resource.data.get('scheduleStatus', nextSchedule.get('status', ''));
      let timeChoices = nextSchedule.get('timeChoices', []);
      let finalTimeChoice = nextSchedule.get('finalTimeChoice', {});

      // 정책 도입 전 생성된 진행 중 매칭은 기존 일정을 마칠 수 있게 유지한다.
      // 신규 정책 매칭은 DB에 고정된 후보 ID 외의 날짜를 저장할 수 없다.
      return policyVersion != 'next_weekend_kst_v1' || (
        allowedIds is list &&
        allowedStartAt is map &&
        (
          !(nextScheduleStatus in ['waiting_counterpart', 'needs_final_choice']) ||
          (
            timeChoices is list &&
            timeChoices.size() == 3 &&
            timeChoices[0].get('id', '') in allowedIds &&
            timeChoices[1].get('id', '') in allowedIds &&
            timeChoices[2].get('id', '') in allowedIds &&
            timeChoices[0].get('startAtClient', '') == allowedStartAt.get(timeChoices[0].get('id', ''), '') &&
            timeChoices[1].get('startAtClient', '') == allowedStartAt.get(timeChoices[1].get('id', ''), '') &&
            timeChoices[2].get('startAtClient', '') == allowedStartAt.get(timeChoices[2].get('id', ''), '') &&
            timeChoices[0].get('id', '') != timeChoices[1].get('id', '') &&
            timeChoices[0].get('id', '') != timeChoices[2].get('id', '') &&
            timeChoices[1].get('id', '') != timeChoices[2].get('id', '')
          )
        ) &&
        (
          nextScheduleStatus != 'confirmed' ||
          (
            finalTimeChoice.get('id', '') in allowedIds &&
            finalTimeChoice.get('startAtClient', '') == allowedStartAt.get(finalTimeChoice.get('id', ''), '')
          )
        )
      );
    }

    function validTwoWeeksCafeChoice(choice) {
      let cafeId = choice.get('cafeId', choice.get('placeId', choice.get('id', '')));
      let cafePath = /databases/$(database)/documents/twoweeksCafeCandidates/$(cafeId);
      return cafeId != '' &&
        exists(cafePath) &&
        get(cafePath).data.get('status', '') == 'active' &&
        choice.get('cafeName', '') == get(cafePath).data.get('name', '') &&
        choice.get('area', '') == get(cafePath).data.get('area', '');
    }

    function validTwoWeeksSchedulePlaceChoices() {
      let nextSchedule = request.resource.data.get('schedule', {});
      let nextStatus = request.resource.data.get('scheduleStatus', nextSchedule.get('status', ''));
      let choices = nextSchedule.get('placeChoices', []);
      let finalChoice = nextSchedule.get('finalPlaceChoice', {});
      let finalId = finalChoice.get('cafeId', finalChoice.get('placeId', finalChoice.get('id', '')));

      return (
        !(nextStatus in ['waiting_counterpart', 'needs_final_choice']) ||
        (
          choices is list &&
          choices.size() == 3 &&
          validTwoWeeksCafeChoice(choices[0]) &&
          validTwoWeeksCafeChoice(choices[1]) &&
          validTwoWeeksCafeChoice(choices[2]) &&
          choices[0].get('cafeId', choices[0].get('placeId', choices[0].get('id', ''))) !=
            choices[1].get('cafeId', choices[1].get('placeId', choices[1].get('id', ''))) &&
          choices[0].get('cafeId', choices[0].get('placeId', choices[0].get('id', ''))) !=
            choices[2].get('cafeId', choices[2].get('placeId', choices[2].get('id', ''))) &&
          choices[1].get('cafeId', choices[1].get('placeId', choices[1].get('id', ''))) !=
            choices[2].get('cafeId', choices[2].get('placeId', choices[2].get('id', '')))
        )
      ) && (
        nextStatus != 'confirmed' ||
        (
          choices is list &&
          choices.size() == 3 &&
          finalId in [
            choices[0].get('cafeId', choices[0].get('placeId', choices[0].get('id', ''))),
            choices[1].get('cafeId', choices[1].get('placeId', choices[1].get('id', ''))),
            choices[2].get('cafeId', choices[2].get('placeId', choices[2].get('id', '')))
          ]
        )
      );
    }

    // 관리자 권한 목록은 로그인 사용자에게 UID 확인용으로만 읽기를 허용한다.
    match /adminConfig/{configId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // 기존 차밍수프 사용자 데이터 규칙.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId);
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.toUid == request.auth.uid;
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /charmingCards/{cardId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /charmingCardAnswers/{answerId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    match /interests/{interestId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /manualPayments/{paymentId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /blockedUsers/{docId} {
      allow read, create, update, delete: if signedIn();
    }

    // -----------------------------
    // TwoWeeks
    // -----------------------------

    // 신청서는 관리자 또는 해당 신청서 owner UID만 읽을 수 있다.
    // 문자 magic-link/휴대폰 OTP는 Cloud Functions에서 검증 후 원래 owner UID의 custom auth를 발급한다.
    match /twoweeksApplications/{applicationId} {
      allow read: if isAdmin() || (
        signedIn() &&
        resource.data.get('status', '') != 'withdrawn' &&
        resource.data.get('withdrawal', {}).get('status', '') != 'completed' &&
        (
          resource.data.get('uid', '') == request.auth.uid ||
          hasValidTwoWeeksDashboardSession(applicationId)
        )
      );
      allow create: if isAdmin() || (
        signedIn() &&
        request.resource.data.get('uid', '') == request.auth.uid &&
        validInitialTwoWeeksDeposit() &&
        validTwoWeeksRequiredConsentsAtCreate() &&
        validTwoWeeksIdentityAtCreate() &&
        validTwoWeeksProfilePhotosAtWrite()
      );
      allow update: if isAdmin() || (
        signedIn() &&
        request.resource.data.get('uid', '') == resource.data.get('uid', '') &&
        (
          resource.data.get('uid', '') == request.auth.uid ||
          hasValidTwoWeeksDashboardSession(applicationId)
        ) &&
        twoweeksProtectedApplicationFieldsUnchanged() &&
        (
          request.resource.data.get('identity', {}) == resource.data.get('identity', {}) ||
          validTwoWeeksProfilePhotosAtWrite()
        )
      );
      allow delete: if isAdmin();
    }

    // 본인인증 서버 확인 기록. 클라이언트에서는 직접 조회/수정하지 않는다.
    match /twoweeksIdentityVerifications/{verificationId} {
      allow read, create, update, delete: if false;
    }

    // 직업/재직 인증자료 원문은 일반 신청서와 분리한다.
    // 고객은 최초 업로드만 가능하며 관리자 내부등급 필드는 이 문서에 쓸 수 없다.
    match /twoweeksApplicationPrivate/{applicationId} {
      allow read: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.get('ownerUid', '') == request.auth.uid &&
        request.resource.data.get('applicationId', '') == applicationId &&
        request.resource.data.keys().hasOnly([
          'applicationId',
          'ownerUid',
          'verificationDocument',
          'createdAt',
          'updatedAt'
        ]);
      allow update, delete: if isAdmin();
    }

    // 프로필 매력도/조건 경쟁력/매칭 신뢰도/관리자 확인 회사유형은 완전한 관리자 전용 데이터다.
    match /twoweeksApplicationAdminMeta/{applicationId} {
      allow read, create, update, delete: if isAdmin();
    }

    // 마케팅 캠페인·방문 집계·수정이력은 Cloud Functions에서만 기록한다.
    // 관리자 화면도 검증된 callable 결과만 사용해 방문 식별값이 브라우저로 내려가지 않게 한다.
    // 활성 이벤트와 콘텐츠만 공개. 생성·변경·지급 기록은 Cloud Functions 전용.
    match /twoweeksReferralEvents/{eventId} {
      allow get, list: if isAdmin() || resource.data.get('active', false) == true;
      allow create, update, delete: if false;
    }
    match /twoweeksDatingNotes/{noteId} {
      allow get, list: if isAdmin() || resource.data.get('active', false) == true;
      allow create, update, delete: if false;
    }
    match /twoweeksReferralInvites/{inviteHash} {
      allow read, write: if false;
    }
    match /twoweeksReferralInviteOwners/{applicationId} {
      allow read, write: if false;
    }
    match /twoweeksReferralRewards/{inviteeApplicationId} {
      allow read, write: if false;
    }

    match /twoweeksMarketingCampaigns/{campaignCode} {
      allow read, create, update, delete: if false;
    }

    match /twoweeksCampaignVisits/{visitId} {
      allow read, create, update, delete: if false;
    }

    match /twoweeksMarketingAuditLogs/{logId} {
      allow read, create, update, delete: if false;
    }

    // dashboard magic-link token hash / OTP challenge / rate-limit은 서버(Admin SDK)에서만 접근한다.
    match /twoweeksDashboardAccess/{applicationId} {
      allow read, write: if false;
    }

    match /twoweeksDashboardOtpChallenges/{challengeId} {
      allow read, write: if false;
    }

    // 휴대폰 OTP 또는 magic-link 검증 후 서버가 현재 Firebase Auth UID에
    // 특정 신청서 접근권한을 임시 부여한다. 클라이언트는 세션 문서를 직접 읽거나 쓸 수 없다.
    match /twoweeksDashboardSessions/{sessionUid} {
      allow read, write: if false;
    }

    match /twoweeksSecurityRateLimits/{limitId} {
      allow read, write: if false;
    }

    // 반환 계좌 원문은 관리자만 조회한다. 쓰기는 Cloud Functions(Admin SDK)에서만 수행한다.
    match /twoweeksDepositRefundPrivate/{applicationId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // 탈퇴 상세 사유·반환 계좌·처리 로그는 관리자와 Admin SDK만 접근한다.
    match /twoweeksWithdrawalPrivate/{applicationId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /twoweeksWithdrawalLogs/{applicationId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /twoweeksRounds/{roundId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /twoweeksCafeCandidates/{cafeId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /twoweeksProposalResponses/{responseId} {
      allow read: if isAdmin() || (signedIn() && isTwoWeeksResponseParticipant(resource.data));
      allow create: if isAdmin() || (
        signedIn() &&
        validTwoWeeksResponseOwnerWrite() &&
        validTwoWeeksResponseMatchBinding(responseId)
      );
      allow update: if isAdmin() || (
        signedIn() &&
        isTwoWeeksResponseParticipant(resource.data) &&
        ownsTwoWeeksApplication(resource.data.get('viewerApplicationId', '')) &&
        request.resource.data.get('viewerApplicationId', '') == resource.data.get('viewerApplicationId', '') &&
        request.resource.data.get('candidateApplicationId', '') == resource.data.get('candidateApplicationId', '') &&
        request.resource.data.get('matchId', '') == resource.data.get('matchId', '') &&
        request.resource.data.get('response', '') == resource.data.get('response', '') &&
        request.resource.data.get('status', '') == resource.data.get('status', '') &&
        validTwoWeeksResponseOwnerWrite() &&
        validTwoWeeksResponseMatchBinding(responseId)
      );
      allow delete: if isAdmin();
    }

    // 상세 거절 사유는 서버가 기록하고 관리자만 확인한다.
    match /twoweeksProposalDeclineReasons/{reasonId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 피드백 token -> match 매핑은 서버에서만 조회/기록한다.
    // 고객 URL에서 내부 matchId/roundId(beta 등)를 숨기기 위한 lookup 문서다.
    match /twoweeksFeedbackAccess/{accessId} {
      allow read, write: if false;
    }

    // 피드백 원문과 접근 토큰은 상대 참여자에게 노출하지 않고 관리자/서버에서만 사용한다.
    match /twoweeksFeedbackPrivate/{matchId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // 이용후기/성공스토리 작성 token 매핑은 서버에서만 관리한다.
    match /twoweeksMarketingAccess/{accessId} {
      allow read, write: if false;
    }

    // 원본 후기에는 내부 match/application 식별자가 포함되므로 관리자만 조회한다.
    // 작성/수정은 Cloud Functions(Admin SDK)에서만 수행한다.
    match /twoweeksReviews/{reviewId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /twoweeksSuccessStories/{storyId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 관리자 검토 후 익명 처리된 마케팅용 문서만 누구나 읽을 수 있다.
    // 실명·회사명·연락처·matchId/applicationId는 이 컬렉션에 저장하지 않는다.
    match /twoweeksPublicReviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    match /twoweeksPublicSuccessStories/{storyId} {
      allow read: if true;
      allow write: if false;
    }

    // 알림 중복 방지용 서버 내부 잠금 문서.
    match /twoweeksNotificationLocks/{lockId} {
      allow read, write: if false;
    }

    match /twoweeksAdminLifecycleNotifications/{notificationId} {
      allow read, write: if false;
    }

    // 매칭 문서는 관리자 또는 실제 두 참여자만 읽을 수 있다.
    // 고객 업데이트는 현재 UI가 사용하는 진행 필드로만 한정하고, 피드백/연락처/운영판정은 서버만 변경한다.
    match /twoweeksMatches/{matchId} {
      allow read: if isAdmin() || (signedIn() && isTwoWeeksMatchParticipant(resource.data));
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() &&
        isTwoWeeksMatchParticipant(resource.data) &&
        request.resource.data.get('maleApplicationId', '') == resource.data.get('maleApplicationId', '') &&
        request.resource.data.get('femaleApplicationId', '') == resource.data.get('femaleApplicationId', '') &&
        request.resource.data.get('roundId', '') == resource.data.get('roundId', '') &&
        preservesTwoWeeksTerminalMatchState() &&
        twoweeksMatchParticipantUpdateOnlyAllowedFields() &&
        validTwoWeeksScheduleTimeChoices() &&
        validTwoWeeksSchedulePlaceChoices()
      );
    }

    // 노쇼·당일취소·제재 이력은 서버 함수만 기록하고 관리자만 조회한다.
    match /twoweeksSanctions/{sanctionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // 기존 서비스에서 사용 중인 나머지 컬렉션은 종전 로그인 기반 접근을 유지한다.
    // 신규 민감 컬렉션은 이 목록에 넣지 않고 별도 규칙을 작성한다.
    match /{collectionId}/{document=**} {
      allow read, write: if signedIn() && collectionId in [
        'ViewsData',
        'accountDeletionLogs',
        'appStats',
        'arenaInterests',
        'arenaMatches',
        'arenaOffers',
        'arenaRejects',
        'arenaReports',
        'blogs',
        'blogsDescription',
        'blogsMeta',
        'boards',
        'careers',
        'charmingCardAnswerReactions',
        'charmingCardAnswerReports',
        'coccocs',
        'comments',
        'conversations',
        'couples',
        'datecards',
        'educations',
        'joboffers',
        'mail',
        'messages',
        'mystyle',
        'posts',
        'preference_rate',
        'publicStats',
        'sections',
        'singos',
        'skills',
        'spoonDepositRequests',
        'spoonHistories',
        'subscribes',
        'test_real'
      ];
    }
  }
}
